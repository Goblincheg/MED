<Window x:Class="EmojiPicker.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки MED" Width="470" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource SearchForegroundBrush}" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{DynamicResource SearchForegroundBrush}"/></Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource SearchForegroundBrush}"/>
            <Setter Property="Background" Value="{DynamicResource SearchBackgroundBrush}"/>
        </Style>
    </Window.Resources>
    <StackPanel Margin="20">
        <TextBlock Text="MED — Mikhalych Emoji Dock" FontSize="18" FontWeight="SemiBold"/>
        <TextBlock Text="Мёд · 1.0.0 · Win + . открывает панель" Margin="0,5,0,16"/>
        <CheckBox x:Name="TrayToggle" Content="Показывать значок в трее" Click="TrayToggle_Click" Margin="0,0,0,12"/>
        <CheckBox x:Name="StartupToggle" Content="Запускать MED при входе в Windows" Click="StartupToggle_Click"/>
        <TextBlock x:Name="StartupStatus" TextWrapping="Wrap" Margin="0,6,0,5"/>
        <Button x:Name="RemoveStartupButton" Content="Удалить запись автозагрузки MED" HorizontalAlignment="Left"
                Padding="8,4" Click="RemoveStartup_Click" Margin="0,0,0,14"/>
        <CheckBox x:Name="LoggingToggle" Content="Диагностический журнал" Click="LoggingToggle_Click" Margin="0,0,0,12"/>
        <TextBlock Text="Каталог данных:" FontWeight="SemiBold"/>
        <TextBox x:Name="DataDirectory" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0"
                 Background="Transparent" Foreground="{DynamicResource SearchForegroundBrush}" Margin="0,4,0,8"/>
        <TextBlock Text="Без значка MED продолжает работать. Настройки доступны по шестерёнке в панели. При предупреждении значок может появиться на время уведомления."
                   TextWrapping="Wrap" Margin="0,0,0,14"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="ExitButton" Content="Выход из MED" Click="Exit_Click" Padding="12,6" Margin="0,0,8,0"/>
            <Button Content="Закрыть" Click="Close_Click" Padding="12,6"/>
        </StackPanel>
    </StackPanel>
</Window>
